# Native API. Compose binds its API to the internal network on port 3000.
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# Catalogue startup and owner-curated product IDs.
CATALOGUE_SOURCE=live
CATALOGUE_FEATURED_HOME=1,2,5,9,15
CATALOGUE_FEATURED_CATEGORIES='{"mens-clothing":1,"jewelery":5,"electronics":9,"womens-clothing":15}'

# Native Vite server.
WEB_PORT=5173
